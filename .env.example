# =====================================================================
# GLOBO-3D — Variáveis de ambiente
# Copie este arquivo para .env.local e preencha com a connection string
# do seu banco Neon (PostgreSQL).
#
# Sem essa variável, o app funciona normalmente em MODO LOCAL
# (as mensagens voam, mas não são salvas nem compartilhadas entre usuários).
#
# IMPORTANTE: esta é uma variável de SERVIDOR (sem NEXT_PUBLIC_). A senha do
# banco nunca chega ao navegador — o acesso é feito pelas rotas /api/messages.
# =====================================================================

# Pegue no painel do Neon: Dashboard > seu projeto > Connection Details
# Use a connection string "Pooled" (recomendada para serverless).
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require

# =====================================================================
# Autenticação real (Neon Auth / Stack Auth) — OPCIONAL
# Sem estas variáveis, o app usa o login mock atual.
# Pegue no console do Neon: seu projeto > Auth (Configuration / Keys).
# =====================================================================
NEXT_PUBLIC_STACK_PROJECT_ID=seu-project-id
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=sua-publishable-client-key
STACK_SECRET_SERVER_KEY=sua-secret-server-key

# URL do JWKS do Neon Auth (para o servidor verificar tokens)
NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.regiao.aws.neon.tech/neondb/auth/.well-known/jwks.json
