# =====================================================================
# GLOBO-3D — Variáveis de ambiente
# Copie este arquivo para .env.local e preencha com as credenciais do
# seu projeto Supabase (Project Settings > API).
#
# Sem essas variáveis, o app funciona normalmente em MODO LOCAL
# (as mensagens voam, mas não são salvas nem compartilhadas entre usuários).
# =====================================================================

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
