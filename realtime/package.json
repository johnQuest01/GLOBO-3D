{
  "name": "globo-realtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servidor de presenca, beacons e sinalizacao WebRTC do GLOBO-3D. Always-on, fora da Vercel.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "probe": "tsx scripts/probe.ts",
    "test:store": "tsx scripts/teste-store.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "ioredis": "^5.4.1",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/web-push": "^3.6.4",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
